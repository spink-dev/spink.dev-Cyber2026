# Copy to .env for local development. Never commit .env.
# Vercel: set the same names under Project > Settings > Environment Variables
# (Production / Preview / Development scopes).

ENVIRONMENT=dev

# Public site URL (used for canonical URLs, sitemap, auth redirects).
# Leave unset on Vercel to derive it from VERCEL_PROJECT_PRODUCTION_URL.
SITE_URL=http://localhost:4321

# Supabase. From `npm run db:start` (local) or the dashboard's Connect dialog (cloud).
# The publishable key is safe in the browser; RLS protects the data.
PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Bypasses row level security. Only for trusted server code (cron, admin tasks).
SUPABASE_SECRET_KEY=
