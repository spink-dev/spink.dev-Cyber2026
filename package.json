{
    "name": "astro-template",
    "description": "Astro + Tailwind v4 + Supabase + Vercel project template",
    "type": "module",
    "version": "0.1.0",
    "private": true,
    "engines": {
        "node": ">=22.12.0"
    },
    "scripts": {
        "dev": "astro dev",
        "build": "astro build",
        "preview": "astro preview",
        "astro": "astro",
        "check": "astro check",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:e2e": "playwright test",
        "test:e2e:ui": "playwright test --ui",
        "verify": "npm run format:check && npm run lint && npm run check && npm run test && npm run build",
        "db:start": "supabase start",
        "db:stop": "supabase stop",
        "db:status": "supabase status",
        "db:reset": "supabase reset",
        "db:migration": "supabase migration new",
        "db:diff": "supabase db diff --local -f",
        "db:push": "supabase db push",
        "db:types": "supabase gen types typescript --local > src/lib/supabase/database.types.ts",
        "db:types:remote": "supabase gen types typescript --linked > src/lib/supabase/database.types.ts",
        "db:link": "supabase link"
    },
    "dependencies": {
        "@astrojs/sitemap": "^3.7.4",
        "@astrojs/vercel": "^11.0.10",
        "@supabase/ssr": "^0.12.6",
        "@supabase/supabase-js": "^2.115.0",
        "@tailwindcss/vite": "^4.3.3",
        "astro": "^7.3.1",
        "tailwindcss": "^4.3.3"
    },
    "devDependencies": {
        "@astrojs/check": "^0.9.10",
        "@eslint/js": "^9.39.5",
        "@playwright/test": "^1.63.0",
        "@types/node": "^26.4.1",
        "@typescript-eslint/parser": "^8.69.0",
        "eslint": "^9.39.5",
        "eslint-plugin-astro": "^1.7.0",
        "eslint-plugin-jsx-a11y": "^6.10.2",
        "globals": "^16.5.0",
        "prettier": "^3.9.6",
        "prettier-plugin-astro": "^0.14.1",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "supabase": "^2.116.0",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.69.0",
        "vitest": "^5.0.0"
    },
    "allowScripts": {
        "esbuild": true,
        "supabase": true
    }
}
